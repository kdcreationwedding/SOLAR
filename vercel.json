{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt|googleeb9fa9ff94575305\\.html)",
      "destination": "/$1"
    },
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|googleeb9fa9ff94575305\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
